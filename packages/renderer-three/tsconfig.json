{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@forge/core": [
        "../core/src"
      ]
    },
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "../core/tsconfig.json"
    }
  ],
  "include": [
    "src/**/*.ts"
  ]
}
